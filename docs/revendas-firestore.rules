// Regras do cadastro de Revendas (Administração > Revendas) e dos Parâmetros Proposta de cada revenda.
// Cole estes blocos DENTRO do "match /databases/{database}/documents { ... }" das regras atuais do Firestore
// (console do Firebase > Firestore Database > Regras) e clique em Publicar. Não apague as regras que já existem:
// estes blocos só ACRESCENTAM permissões (no Firestore, basta uma regra permitir).
//
// revendas/{rid}: nome, estados (UFs de atuação) e gerente (uid). Só o ADM cria, altera e exclui.
// O vínculo de cada pessoa fica no cadastro dela (usuarios/{uid}.revenda), gravado pelo ADM com as regras que já existem.
// revendas/{rid}/parametros/proposta: Parâmetros Proposta próprios da revenda. Os usuários da revenda leem;
// o gerente dela publica; o ADM também pode apagar (volta para os parâmetros gerais).

    function rvEu() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function rvAtivo() { return request.auth != null && rvEu().ativo == true; }
    function rvAdm() { return rvAtivo() && (rvEu().get('papel', '') == 'adm' || 'adm' in rvEu().get('papeis', [])); }
    function rvMembro(rid) { return rvAtivo() && rvEu().get('revenda', '') == rid; }
    function rvGerente(rid) { return rvMembro(rid) && get(/databases/$(database)/documents/revendas/$(rid)).data.get('gerente', '') == request.auth.uid; }

    match /revendas/{rid} {
      allow read: if rvAdm() || rvMembro(rid);
      allow write: if rvAdm();
      // o gerente ajusta só os Valores de base da própria revenda (km, validade, portes, bases de deslocamento)
      allow update: if rvGerente(rid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['base', 'atualizado']);

      match /parametros/{pid} {
        allow read: if rvAdm() || rvMembro(rid);
        allow create, update: if pid == 'proposta' && (rvAdm() || rvGerente(rid));
        allow delete: if rvAdm();
      }
    }

// Gerente da revenda vê a equipe: lista os usuários da própria revenda e as propostas e leads/fichas do CRM deles (só leitura).
// Usado na tela Hoje (próximos passos das propostas da equipe). Não libera nenhuma gravação.

    function rvSouGerente() { return rvAtivo() && rvEu().get('revenda', '') != '' && rvGerente(rvEu().get('revenda', '')); }
    function rvDaEquipe(uid) { return rvSouGerente() && get(/databases/$(database)/documents/usuarios/$(uid)).data.get('revenda', '') == rvEu().get('revenda', ''); }

    match /usuarios/{uid} {
      allow read: if rvSouGerente() && resource.data.get('revenda', '') == rvEu().get('revenda', '');
    }
    match /propostas/{id} {
      allow list: if rvDaEquipe(resource.data.owner);
    }
    match /crm/{id} {
      allow read: if rvDaEquipe(resource.data.owner);
    }
